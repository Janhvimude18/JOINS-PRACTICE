-- Table 2: Flights
CREATE TABLE Flights (
    FlightID INT PRIMARY KEY,
    AirlineID INT,
    Source VARCHAR(50),
    Destination VARCHAR(50),
    DepartureTime DATETIME,
    ArrivalTime DATETIME,
    FOREIGN KEY (AirlineID) REFERENCES Airlines(AirlineID)
);

