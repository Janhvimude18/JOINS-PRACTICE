#INNER JOIN (Passengers with their Flight Details)
SELECT p.FullName, f.FlightID, f.Source, f.Destination, a.AirlineName
FROM Passengers p
INNER JOIN Bookings b ON p.PassengerID = b.PassengerID
INNER JOIN Flights f ON b.FlightID = f.FlightID
INNER JOIN Airlines a ON f.AirlineID = a.AirlineID;


# LEFT JOIN (All Flights and their Bookings, even if no passengers yet)
SELECT f.FlightID, f.Source, f.Destination,  b.BookingID, p.FullName
FROM Flights f
LEFT JOIN Bookings b ON f.FlightID = b.FlightID
LEFT JOIN Passengers p ON b.PassengerID = p.PassengerID;

#RIGHT JOIN (All Passengers, even if they don’t have a booking)

SELECT p.FullName, b.BookingID, f.FlightID
FROM Passengers p
RIGHT JOIN Bookings b ON p.PassengerID = b.PassengerID
RIGHT JOIN Flights f ON b.FlightID = f.FlightID;

#FULL OUTER JOIN (Passengers & Flights – show everything)
#In MySQL use UNION since FULL OUTER JOIN isn’t directly supported
SELECT p.FullName, f.FlightID, f.Source, f.Destination
FROM Passengers p
LEFT JOIN Bookings b ON p.PassengerID = b.PassengerID
LEFT JOIN Flights f ON b.FlightID = f.FlightID
UNION
SELECT p.FullName, f.FlightID, f.Source, f.Destination
FROM Passengers p
RIGHT JOIN Bookings b ON p.PassengerID = b.PassengerID
RIGHT JOIN Flights f ON b.FlightID = f.FlightID;

