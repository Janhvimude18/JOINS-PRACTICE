-- Create Database
CREATE DATABASE AirlineDB;
USE AirlineDB;

-- Table 1: Airlines
CREATE TABLE Airlines (
    AirlineID INT PRIMARY KEY,
    AirlineName VARCHAR(50),
    Country VARCHAR(50)
);

